<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">
<%- include('nav') %>

<style>
    .appointment-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    }
    .status-badge-scheduled {
        background-color: #e0f2fe;
        color: #0369a1;
        font-weight: 600;
        border-radius: 20px;
        padding: 6px 14px;
    }
    .status-badge-completed {
        background-color: #dcfce7;
        color: #15803d;
        font-weight: 600;
        border-radius: 20px;
        padding: 6px 14px;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
</style>

<div class="container py-5">

    <!-- Personalized Welcome Banner -->
    <% if (user) { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, rgba(25, 135, 84, 0.12), rgba(13, 110, 253, 0.12)); border-left: 6px solid #0d6efd !important;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <span class="badge bg-primary px-3 py-2 rounded-pill mb-2">Patient Dashboard</span>
                    <h3 class="fw-bold text-dark mb-1">
                        Welcome back, <span class="text-primary"><%= user.name %></span>! 👋
                    </h3>
                    <p class="text-muted mb-0 small">
                        <i class="fas fa-id-card me-1 text-primary"></i> Aadhaar / ID: <strong><%= user.aadhaar_id %></strong> &nbsp;|&nbsp; 
                        <i class="fas fa-phone me-1 text-success"></i> Mobile: <strong><%= user.mobile %></strong>
                    </p>
                </div>
                <a href="/prescriptions" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="fas fa-file-prescription me-1"></i> View My Prescriptions
                </a>
            </div>
        </div>
    <% } %>

    <div class="row g-4">
        <!-- Booking Form Panel -->
        <div class="col-lg-5">
            <div class="card appointment-card p-4">
                <div class="border-bottom pb-3 mb-4">
                    <h4 class="fw-bold text-dark mb-1">
                        <i class="fas fa-calendar-plus text-primary me-2"></i>Schedule Visit
                    </h4>
                    <p class="text-muted small mb-0">Choose your specialist and preferred consultation timing.</p>
                </div>

                <form action="/appointments/book" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Consulting Doctor</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-user-doctor text-primary"></i></span>
                            <select name="doctor_id" class="form-select" required>
                                <option value="" disabled selected>-- Select Specialization & Doctor --</option>
                                <% doctors.forEach(function(doc) { %>
                                    <option value="<%= doc.id %>"><%= doc.name %> (<%= doc.specialization %>)</option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Consultation Date</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="far fa-calendar-alt text-primary"></i></span>
                            <input type="date" name="appointment_date" class="form-control" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Time Slot</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="far fa-clock text-primary"></i></span>
                            <input type="time" name="appointment_time" class="form-control" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm">
                        <i class="fas fa-check-circle me-1"></i> Confirm Appointment
                    </button>
                </form>
            </div>
        </div>

        <!-- Bookings Overview Panel -->
        <div class="col-lg-7">
            <div class="card appointment-card overflow-hidden">
                <div class="p-4 border-bottom bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Your Consultation Queue</h4>
                        <p class="text-muted small mb-0">All upcoming and previous doctor bookings</p>
                    </div>
                    <span class="badge bg-primary rounded-pill px-3 py-2">
                        <%= appointments.length %> Total
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3 ps-4">Doctor & Specialty</th>
                                <th class="py-3">Date</th>
                                <th class="py-3">Time</th>
                                <th class="py-3 pe-4 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (appointments.length > 0) { %>
                                <% appointments.forEach(function(row) { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3 p-2 bg-light rounded-circle text-primary">
                                                    <i class="fas fa-stethoscope"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark"><%= row.doctor_name %></div>
                                                    <small class="text-muted"><%= row.specialization %></small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-secondary fw-semibold">
                                            <%= new Date(row.appointment_date).toLocaleDateString('en-GB') %>
                                        </td>
                                        <td class="text-secondary">
                                            <%= row.appointment_time %>
                                        </td>
                                        <td class="pe-4 text-center">
                                            <% if (row.status === 'Completed') { %>
                                                <span class="status-badge-completed">
                                                    <i class="fas fa-check-double me-1"></i>Completed
                                                </span>
                                            <% } else { %>
                                                <span class="status-badge-scheduled">
                                                    <i class="far fa-clock me-1"></i><%= row.status || 'Scheduled' %>
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="far fa-calendar-xmark fa-2x mb-2 text-secondary d-block"></i>
                                        No active appointments found. Schedule your first consultation using the form.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>