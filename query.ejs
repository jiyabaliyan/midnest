<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">
<%- include('nav') %>

<style>
    .support-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }
    .faq-item {
        background: #f8fafc;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 10px;
    }
</style>

<div class="container py-5" style="max-width: 950px;">
    <div class="text-center mb-5">
        <h3 class="fw-bold text-dark"><i class="fas fa-headset text-primary me-2"></i>Patient Helpdesk & Queries</h3>
        <p class="text-muted">Have a question regarding your appointment, medicine dosage, or health records? Submit a ticket below.</p>
    </div>

    <div class="row g-4">
        <!-- Ticket Form -->
        <div class="col-lg-7">
            <div class="card support-card p-4 p-md-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-paper-plane text-success me-2"></i>Submit Support Request</h5>
                
                <% if (success) { %>
                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        <div><%= success %></div>
                    </div>
                <% } %>

                <form action="/query" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject / Department</label>
                        <input type="text" name="subject" class="form-control rounded-3 py-2" placeholder="e.g., Medicine refill inquiry / Reschedule appointment" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message Description</label>
                        <textarea name="message" class="form-control rounded-3" rows="5" placeholder="Explain your medical query or technical difficulty clearly..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm">
                        <i class="fas fa-envelope-circle-check me-1"></i> Dispatch Query
                    </button>
                </form>
            </div>
        </div>

        <!-- FAQs sidebar -->
        <div class="col-lg-5">
            <div class="card support-card p-4 bg-white">
                <h5 class="fw-bold mb-3"><i class="fas fa-circle-question text-primary me-2"></i>Quick Help</h5>
                
                <div class="faq-item">
                    <h6 class="fw-bold text-dark mb-1 small">How quickly do doctors respond?</h6>
                    <p class="text-muted mb-0 small">Desk responses are answered within 24 operational hours.</p>
                </div>

                <div class="faq-item">
                    <h6 class="fw-bold text-dark mb-1 small">Emergency Symptoms?</h6>
                    <p class="text-muted mb-0 small">Do not wait for queries. Immediately call emergency at <strong>108 / 112</strong>.</p>
                </div>

                <div class="faq-item">
                    <h6 class="fw-bold text-dark mb-1 small">Prescription Missing?</h6>
                    <p class="text-muted mb-0 small">Digital prescriptions are visible only after the consulting doctor enters them at discharge.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>