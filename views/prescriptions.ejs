<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">
<%- include('nav') %>

<style>
    .rx-card {
        background: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        border-left: 6px solid #0d6efd;
        transition: transform 0.2s;
    }
    .rx-card:hover {
        transform: translateY(-3px);
    }
    .rx-symbol {
        font-family: serif;
        font-size: 2.2rem;
        font-weight: 900;
        color: #0d6efd;
        line-height: 1;
    }
    .badge-soft {
        background-color: #e0f2fe;
        color: #0369a1;
        font-weight: 600;
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="fas fa-file-prescription text-primary me-2"></i>Digital Prescriptions</h3>
            <p class="text-muted mb-0">Official digital consultation summaries and doctor advice</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="fas fa-print me-1"></i> Print Records
        </button>
    </div>

    <% if (prescriptions.length > 0) { %>
        <div class="row g-4">
            <% prescriptions.forEach(function(row) { %>
                <div class="col-lg-6">
                    <div class="card rx-card h-100 p-4">
                        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                            <div>
                                <h5 class="fw-bold text-primary mb-1"><%= row.doctor_name %></h5>
                                <span class="badge badge-soft px-3 py-1 rounded-pill"><%= row.specialization %></span>
                            </div>
                            <div class="text-end">
                                <span class="rx-symbol">℞</span>
                                <div class="text-muted small mt-1">
                                    <i class="far fa-calendar-alt me-1"></i><%= new Date(row.created_at).toLocaleDateString('en-GB') %>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-uppercase text-muted fw-bold small tracking-wide">Diagnosis / Clinical Impression</label>
                            <div class="p-3 bg-light rounded-3 mt-1 fw-semibold text-dark border-start border-3 border-danger">
                                <%= row.diagnosis %>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-uppercase text-muted fw-bold small tracking-wide">Doctor's Clinical Advice & Notes</label>
                            <div class="p-3 bg-light rounded-3 mt-1 text-secondary">
                                <%= row.instructions || 'Standard rest, hydration, and review after completing medication.' %>
                            </div>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
                            <span><i class="fas fa-shield-halved text-success me-1"></i> Digitally Verified</span>
                            <span>Prescription ID: #MED-<%= row.id %></span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="text-muted mb-3"><i class="fas fa-notes-medical fa-3x text-secondary"></i></div>
            <h5 class="fw-bold">No Digital Prescriptions Yet</h5>
            <p class="text-muted mb-3">Your doctor will enter your electronic prescriptions here right after your consultation.</p>
            <div>
                <a href="/appointments" class="btn btn-primary rounded-pill px-4">Book a Consultation</a>
            </div>
        </div>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
