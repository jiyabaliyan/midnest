<%- include('head') %>
<%- include('nav') %>
<html lang="en">
<body>
<div class="container py-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white fw-bold py-3">
            <h5 class="mb-0">Create MediNest Account</h5>
        </div>
        <div class="card-body p-4">
            <% if (error) { %>
                <div class="alert alert-danger py-2"><%= error %></div>
            <% } %>
            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input type="text" name="name" class="form-control" placeholder="Enter your full name" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mobile Number</label>
                    <input type="tel" name="mobile" class="form-control" placeholder="Enter mobile number" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Aadhaar Card / Unique ID Number</label>
                    <input type="text" name="aadhaar_id" class="form-control" placeholder="Enter ID number" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Create password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Register</button>
            </form>
            <div class="text-center mt-3">
                <span class="text-muted">Already registered?</span> <a href="/login" class="text-decoration-none fw-semibold">Login here</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
