<%- include('head') %>
<%- include('nav') %>
<html lang="en">
<body>
<div class="container py-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white fw-bold py-3">
            <h5 class="mb-0">Patient Login</h5>
        </div>
        <div class="card-body p-4">
            <% if (error) { %>
                <div class="alert alert-danger py-2"><%= error %></div>
            <% } %>
            <form action="/login" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Aadhaar / Unique Login ID</label>
                    <input type="text" name="aadhaar_id" class="form-control" placeholder="Enter your ID number" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Login</button>
            </form>
            <div class="text-center mt-3">
                <span class="text-muted">Don't have an account?</span> <a href="/register" class="text-decoration-none fw-semibold">Register here</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
