<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">
<%- include('nav') %>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="fas fa-user-doctor text-primary me-2"></i>Doctor Consultation Desk</h3>
            <p class="text-muted mb-0">Select a booked patient to consult and issue digital prescriptions</p>
        </div>
        <span class="badge bg-primary px-3 py-2 rounded-pill"><%= appointments.length %> Patients Waiting</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 ps-4">Patient Name</th>
                        <th class="py-3">Contact</th>
                        <th class="py-3">Assigned Doctor</th>
                        <th class="py-3">Visit Date & Time</th>
                        <th class="py-3 pe-4 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (appointments.length > 0) { %>
                        <% appointments.forEach(function(row) { %>
                            <tr>
                                <td class="ps-4 fw-bold text-dark"><i class="fas fa-user me-2 text-secondary"></i><%= row.patient_name %></td>
                                <td><%= row.patient_mobile %></td>
                                <td><%= row.doctor_name %></td>
                                <td><%= new Date(row.appointment_date).toLocaleDateString('en-GB') %> (<%= row.appointment_time %>)</td>
                                <td class="pe-4 text-center">
                                    <a href="/doctor/prescribe/<%= row.id %>" class="btn btn-sm btn-success rounded-pill px-3">
                                        <i class="fas fa-file-prescription me-1"></i> Issue Prescription
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-clipboard-check fa-2x mb-2 d-block text-secondary"></i>
                                No pending patient consultations found.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
</body>
</html>
