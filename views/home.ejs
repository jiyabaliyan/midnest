<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">

<%- include('nav') %>

<style>
    .hero-section {
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.08), rgba(13, 110, 253, 0.08));
        border: 1px solid rgba(13, 110, 253, 0.15);
        border-radius: 20px;
        padding: 50px 30px;
    }

    .feature-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .feature-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.12);
    }

    .icon-box {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 18px;
    }

    .icon-green {
        background-color: rgba(25, 135, 84, 0.15);
        color: #198754;
    }

    .icon-blue {
        background-color: rgba(13, 110, 253, 0.15);
        color: #0d6efd;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #198754, #0d6efd);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 10px 28px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-gradient:hover {
        color: white;
        transform: scale(1.04);
        box-shadow: 0 6px 20px rgba(13, 110, 253, 0.3);
    }
</style>

<div class="container py-5">

    <!-- Hero Header -->
    <div class="hero-section text-center mb-5">
        <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 fw-normal">
            <i class="fas fa-heart-pulse me-1"></i> Digital Healthcare Platform
        </span>

        <% if (user) { %>
            <h1 class="display-5 fw-bold text-dark">
                Welcome to <span class="text-primary">MediNest</span>, <span class="text-success"><%= user.name %></span>! 👋
            </h1>
            <p class="lead text-muted mx-auto mt-3" style="max-width: 750px;">
                Your centralized healthcare portal is active. Easily schedule doctor consultations, access digital prescriptions, and track prescribed medications.
            </p>

            <div class="mt-4 d-flex justify-content-center flex-wrap gap-2">
                <a href="/appointments" class="btn btn-gradient">
                    <i class="fas fa-calendar-check me-1"></i> Manage Appointments
                </a>
                <a href="/prescriptions" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="fas fa-file-prescription me-1"></i> View Prescriptions
                </a>
            </div>
        <% } else { %>
            <h1 class="display-5 fw-bold text-dark">Welcome to <span class="text-primary">MediNest</span></h1>
            <p class="lead text-muted mx-auto mt-3" style="max-width: 750px;">
                A unified digital portal to schedule clinical consultations, monitor prescriptions, and securely store your complete medical history online.
            </p>

            <div class="mt-4 d-flex justify-content-center flex-wrap gap-2">
                <a href="/login" class="btn btn-gradient">
                    <i class="fas fa-right-to-bracket me-1"></i> Patient Login
                </a>
                <a href="/register" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="fas fa-user-plus me-1"></i> Create Account
                </a>
            </div>
        <% } %>
    </div>

    <!-- Feature Grid -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card feature-card h-100 p-4 text-center">
                <div class="icon-box icon-green mx-auto">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h5 class="fw-bold mb-2">Doctor Appointments</h5>
                <p class="text-muted small">
                    Browse specialists, check visiting hours, and reserve your consultation slots in real-time.
                </p>
                <div class="mt-auto">
                    <a href="/appointments" class="text-decoration-none fw-semibold text-success">
                        Book Slot <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card feature-card h-100 p-4 text-center">
                <div class="icon-box icon-blue mx-auto">
                    <i class="fas fa-file-prescription"></i>
                </div>
                <h5 class="fw-bold mb-2">Digital Prescriptions</h5>
                <p class="text-muted small">
                    Never worry about lost slips. Access your doctor diagnoses, clinical advice, and medication plans anytime.
                </p>
                <div class="mt-auto">
                    <a href="/prescriptions" class="text-decoration-none fw-semibold text-primary">
                        View Records <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card feature-card h-100 p-4 text-center">
                <div class="icon-box icon-green mx-auto">
                    <i class="fas fa-pills"></i>
                </div>
                <h5 class="fw-bold mb-2">Medication Tracker</h5>
                <p class="text-muted small">
                    Track current and previous courses of treatment, dosages, and exact timelines prescribed by doctors.
                </p>
                <div class="mt-auto">
                    <a href="/medicines" class="text-decoration-none fw-semibold text-success">
                        View Medicines <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
