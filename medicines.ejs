<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">
<%- include('nav') %>

<style>
    .med-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }
    .dosage-pill {
        background-color: #ecfdf5;
        color: #047857;
        font-weight: 600;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 0.85rem;
    }
    .duration-pill {
        background-color: #fff7ed;
        color: #c2410c;
        font-weight: 600;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 0.85rem;
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1"><i class="fas fa-pills text-success me-2"></i>Prescribed Medications</h3>
        <p class="text-muted mb-0">Track active medicines, daily dosages, and doctor treatment durations</p>
    </div>

    <div class="card med-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 ps-4">Medicine Name</th>
                        <th class="py-3">Recommended Dosage</th>
                        <th class="py-3">Duration</th>
                        <th class="py-3">Prescribing Physician</th>
                        <th class="py-3 pe-4">Date Issued</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (medicines.length > 0) { %>
                        <% medicines.forEach(function(row) { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3 p-2 bg-light rounded-circle text-primary">
                                            <i class="fas fa-capsules"></i>
                                        </div>
                                        <span class="fw-bold text-dark"><%= row.medicine_name %></span>
                                    </div>
                                </td>
                                <td>
                                    <span class="dosage-pill"><i class="fas fa-clock me-1"></i><%= row.dosage %></span>
                                </td>
                                <td>
                                    <span class="duration-pill"><i class="fas fa-calendar-day me-1"></i><%= row.duration %></span>
                                </td>
                                <td class="text-muted fw-semibold">
                                    <%= row.doctor_name %>
                                </td>
                                <td class="text-muted pe-4">
                                    <%= new Date(row.created_at).toLocaleDateString('en-GB') %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-prescription-bottle-medical fa-2x mb-2 text-secondary d-block"></i>
                                No medicines on record yet. Complete an appointment consultation to view medication courses.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>