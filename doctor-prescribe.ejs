<!DOCTYPE html>
<html lang="en">
<%- include('head') %>
<body style="background: #f8fafc; min-height: 100vh;">
<%- include('nav') %>

<div class="container py-5" style="max-width: 750px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <div class="border-bottom pb-3 mb-4">
            <h4 class="fw-bold text-primary mb-1"><i class="fas fa-stethoscope me-2"></i>Medical Consultation & Prescription</h4>
            <p class="text-muted small mb-0">Patient: <strong><%= data.patient_name %></strong> | Doctor: <strong><%= data.doctor_name %> (<%= data.specialization %>)</strong></p>
        </div>

        <form action="/doctor/prescribe" method="POST">
            <input type="hidden" name="appointment_id" value="<%= data.id %>">
            <input type="hidden" name="user_id" value="<%= data.user_id %>">
            <input type="hidden" name="doctor_id" value="<%= data.doctor_id %>">

            <div class="mb-3">
                <label class="form-label fw-semibold">Clinical Diagnosis / Problem</label>
                <input type="text" name="diagnosis" class="form-control" placeholder="e.g., Acute Viral Bronchitis, Hypertension" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Doctor Instructions & Advice</label>
                <textarea name="instructions" class="form-control" rows="3" placeholder="e.g., Drink warm fluids, avoid cold drinks, review after 5 days"></textarea>
            </div>

            <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-capsules text-success me-2"></i>Prescribe Medication</h6>
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="small text-muted fw-semibold">Medicine Name</label>
                        <input type="text" name="medicine_name" class="form-control form-control-sm" placeholder="e.g., Paracetamol 650mg" required>
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted fw-semibold">Dosage</label>
                        <input type="text" name="dosage" class="form-control form-control-sm" placeholder="e.g., 1 tablet after food" required>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted fw-semibold">Duration</label>
                        <input type="text" name="duration" class="form-control form-control-sm" placeholder="e.g., 5 Days (Twice daily)" required>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">
                <i class="fas fa-check-circle me-1"></i> Finalize & Issue Prescription
            </button>
        </form>
    </div>
</div>
</body>
</html>